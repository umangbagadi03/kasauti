# Which LLM to use by default: anthropic | gemini | openai | ollama
LLM_PROVIDER=gemini
# Optional model override (defaults: claude-sonnet-5-5, gemini-2.5-flash, gpt-5-mini, llama3.2-vision)
# LLM_MODEL=

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=          # any OpenAI-compatible server (Azure, Groq, vLLM, LM Studio...)
OLLAMA_BASE_URL=http://localhost:11434

# LLM_TIMEOUT_S=60
# KASAUTI_CACHE_PATH=.kasauti_cache.sqlite   # "off" to disable
# KASAUTI_DEFAULT_REGION=IN                # IN | EU | US — decides which bans are hard stops

# Optional LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=kasauti
